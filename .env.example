# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.

TOKEN=your-bot-token-here

# Bot presence (status) shown under the bot's name.
# Defaults to a custom status "Beep boop"; set to an empty value to show none.
# BOT_ACTIVITY=Beep boop
# BOT_ACTIVITY_TYPE=custom   # custom | watching | playing | listening | competing | streaming

# Future server-monitoring settings (unused for now):
# SERVER_HOST=game.example.com
# SERVER_PORT=27960
# POLL_INTERVAL_SECONDS=60
# STATUS_CHANNEL_ID=123456789012345678

# Optional deployment-path overrides for docker compose. Defaults match the
# standard layout and are set automatically by deploy.sh — you normally don't
# need to touch these.
# BOT_SRC=/opt/etjump-discord-bot
# BOT_ETC=/etc/etjump-discord-bot
# BOT_DATA=/var/lib/etjump-discord-bot